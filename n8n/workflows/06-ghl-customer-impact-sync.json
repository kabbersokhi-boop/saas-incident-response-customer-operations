    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO ghl_effects(effect_id,incident_id,customer_key,effect_type,desired_state)\nSELECT 'service-case:'||i.incident_id||':'||c.slug,i.incident_id,c.slug,'service_case',\n jsonb_build_object('technical_status',i.state,'severity',i.severity,\n 'impact_summary',coalesce(i.summary,'RelayCart service incident'),\n 'revision',i.revision,'updated_at',i.updated_at,'recovered_at',i.recovered_at)\nFROM ir_incidents i JOIN services s ON s.service_key=i.service\nJOIN customer_service_subscriptions css ON css.service_id=s.id AND css.status='active'\nJOIN customers c ON c.id=css.customer_id\nJOIN ghl_contacts gc ON gc.customer_key=c.slug AND gc.location_id='CP8Flhg4iyKzzm6vlOgu'\nWHERE i.environment='production-demo' AND i.state<>'RESOLVED'\nON CONFLICT(effect_id) DO UPDATE SET desired_state=EXCLUDED.desired_state,\n status='PENDING',next_attempt_at=NOW(),updated_at=NOW()\nWHERE ghl_effects.desired_state IS DISTINCT FROM EXCLUDED.desired_state\n  AND ghl_effects.status<>'PROCESSING';",
        "options": {}
      },
      "id": "fc1f5a8d-039b-5dd3-ac63-54e720ecf7b4",
      "name": "Enqueue Subscribed Customers Atomically",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "position": [
        -820,
        0
      ],
      "credentials": {
        "postgres": {
          "id": "dJp5v4e6qmyffUpN",
          "name": "RelayCart Phase 2 Postgres"
        }
      }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH due AS (\n SELECT effect_id FROM ghl_effects\n WHERE (status IN ('PENDING','RETRY','PROCESSING') AND next_attempt_at<=NOW())\n ORDER BY next_attempt_at,created_at,customer_key LIMIT 3 FOR UPDATE SKIP LOCKED\n), claimed AS (\n UPDATE ghl_effects e SET status='PROCESSING',next_attempt_at=NOW()+interval '3 minutes',updated_at=NOW()\n FROM due WHERE e.effect_id=due.effect_id\n RETURNING e.effect_id,e.incident_id,e.customer_key,e.desired_state,e.ghl_record_id\n)\nSELECT * FROM claimed ORDER BY customer_key;",
        "options": {}
      },
      "id": "695343df-5cd2-573b-9834-7a8712fbb954",
      "name": "Claim Three Due Effects",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "position": [
        -540,
        0
      ],
      "credentials": {
        "postgres": {
          "id": "dJp5v4e6qmyffUpN",
