    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT e.effect_id,e.incident_id,e.customer_key,e.ghl_record_id,gc.contact_id,\n 'SC-'||e.incident_id||'-'||e.customer_key AS case_key,\n jsonb_strip_nulls(jsonb_build_object(\n 'case_key','SC-'||e.incident_id||'-'||e.customer_key,\n 'incident_id',e.incident_id,'customer_key',e.customer_key,'service',i.service,\n 'severity',e.desired_state->>'severity',\n 'impact_summary',left(e.desired_state->>'impact_summary',1000),\n 'technical_status',e.desired_state->>'technical_status',\n 'last_technical_update',left(e.desired_state->>'updated_at',10),\n 'recovery_verified_at',left(e.desired_state->>'recovered_at',10),\n 'sync_revision',(e.desired_state->>'revision')::integer,'demo_record','yes')) AS properties,\n i.opened_at::date AS affected_since\nFROM ghl_effects e JOIN ir_incidents i ON i.incident_id=e.incident_id\nJOIN ghl_contacts gc ON gc.customer_key=e.customer_key AND gc.location_id='CP8Flhg4iyKzzm6vlOgu'\nWHERE e.effect_id=$1 AND e.status='PROCESSING';",
        "options": {
          "queryReplacement": "={{ [$json.effect_id] }}"
        }
      },
