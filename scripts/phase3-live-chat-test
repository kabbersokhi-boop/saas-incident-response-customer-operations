#!/usr/bin/env python3
"""Exercise published GHL Conversation AI with one mapped synthetic contact.

Run inside the API container after technical recovery. This uses only the
isolated location's built-in Live Chat channel; no external messages are sent.
"""

from __future__ import annotations

import argparse
import os
import time

import httpx

from app.db import get_connection

RESPONSES = {
    "working": "Yes, it works now.",
    "broken": "No, we are still seeing checkout errors.",
    "ambiguous": "I have not been able to test checkout yet.",
    "timeout": None,
}


def request(client: httpx.Client, method: str, path: str, **kwargs) -> dict:
    response = client.request(method, path, **kwargs)
    if not response.is_success:
        raise RuntimeError(f"GHL {method} {path} returned HTTP {response.status_code}")
    return response.json()


def main() -> None:
    parser = argparse.ArgumentParser()
    parser.add_argument("customer_key")
    parser.add_argument("outcome", choices=RESPONSES)
    args = parser.parse_args()
    with get_connection() as conn:
        row = conn.execute("""SELECT gc.contact_id,e.incident_id,e.ghl_record_id,
                i.state, e.status AS effect_status
            FROM ghl_contacts gc JOIN ghl_effects e ON e.customer_key=gc.customer_key
            JOIN ir_incidents i ON i.incident_id=e.incident_id
            WHERE gc.customer_key=%s AND gc.location_id=%s
              AND i.incident_id=(SELECT incident_id FROM ir_incidents
                WHERE service='checkout-api' AND environment='production-demo'
                ORDER BY opened_at DESC LIMIT 1)""",
            (args.customer_key, os.environ["GHL_LOCATION_ID"])).fetchone()
    if not row or row["state"] != "RECOVERED" or row["effect_status"] != "SUCCEEDED":
        raise RuntimeError("Expected one synced, technically recovered synthetic customer case")
    token = os.environ["GHL_LOCATION_TOKEN"]
    headers = {"Authorization": "Bearer " + token, "Version": "v3",
               "Accept": "application/json"}
    with httpx.Client(base_url="https://services.leadconnectorhq.com", headers=headers,
                      timeout=20, trust_env=False) as client:
        existing = request(client, "GET", "/conversations/search", params={
            "locationId": os.environ["GHL_LOCATION_ID"],
            "contactId": row["contact_id"], "limit": 10}).get("conversations", [])
        if len(existing) > 1:
            raise RuntimeError("Ambiguous synthetic contact conversations")
        if existing:
            conversation_id = existing[0]["id"]
        else:
            conversation = request(client, "POST", "/conversations/", json={
                "locationId": os.environ["GHL_LOCATION_ID"], "contactId": row["contact_id"]})
            conversation_id = conversation["conversation"]["id"]
        request(client, "POST", "/conversations/messages/inbound", json={
            "type": "Live_Chat", "contactId": row["contact_id"],
            "conversationId": conversation_id,
            "message": "Synthetic RelayCart checkout recovery test conversation."})
        # Recovery-ready is a transient test enrollment signal. Remove an old
        # incident's copy so the native Contact Tag trigger gets a fresh event.
        request(client, "DELETE", f"/contacts/{row['contact_id']}/tags", json={
            "tags": ["relaycart-recovery-ready"]})
        time.sleep(1)
        request(client, "POST", f"/contacts/{row['contact_id']}/tags", json={
            "tags": ["relaycart-recovery-ready"]})
        # The native workflow sends its own question; a response before that
        # action is listening would be a false test.
        time.sleep(15)
        if RESPONSES[args.outcome] is not None:
            request(client, "POST", "/conversations/messages/inbound", json={
                "type": "Live_Chat", "contactId": row["contact_id"],
                "conversationId": conversation_id, "message": RESPONSES[args.outcome]})
    print(f"incident={row['incident_id']} customer={args.customer_key} "
          f"test={args.outcome} conversation={conversation_id}")
    print("Wait for the native workflow and GHL 02 feedback poll before auditing the case.")


if __name__ == "__main__":
    main()
