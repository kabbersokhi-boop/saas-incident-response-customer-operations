#!/usr/bin/env python3
"""Read-only, credential-safe audit of current RelayCart GHL Service Cases."""

from __future__ import annotations

import os
import time

import httpx

from app.customer_ops import ASSOCIATION_ID, OBJECT, _request
from app.db import get_connection


def main() -> None:
    with get_connection() as conn:
        rows = conn.execute("""SELECT e.incident_id,e.customer_key,e.ghl_record_id,gc.contact_id
            FROM ghl_effects e JOIN ghl_contacts gc ON gc.customer_key=e.customer_key
            WHERE e.incident_id=(SELECT incident_id FROM ir_incidents
                WHERE environment='production-demo' AND service='checkout-api'
                ORDER BY opened_at DESC LIMIT 1) ORDER BY e.customer_key""").fetchall()
        incident_id = rows[0]["incident_id"] if rows else None
        control = conn.execute("""SELECT count(*) AS cases FROM ghl_effects
            WHERE incident_id=%s AND customer_key='green-dental-21'""",
            (incident_id,)).fetchone()["cases"]
        mapped_ids = {r["contact_id"] for r in conn.execute(
            "SELECT contact_id FROM ghl_contacts WHERE location_id=%s",
            (os.environ["GHL_LOCATION_ID"],)).fetchall()}
    if len(rows) != 18 or control:
        raise RuntimeError("Expected 18 checkout cases and no Green Dental case")
    location = os.environ["GHL_LOCATION_ID"]
    with httpx.Client(base_url="https://services.leadconnectorhq.com", timeout=20,
                      trust_env=False, headers={"Authorization": "Bearer " + os.environ["GHL_LOCATION_TOKEN"],
                                                "Version": "v3", "Accept": "application/json"}) as client:
        control_key = f"SC-{incident_id}-green-dental-21"
        inventory = _request(client, "POST", f"/objects/{OBJECT}/records/search", json={
            "locationId": location, "page": 1, "pageLimit": 100, "searchAfter": []}).get("records", [])
        if len(inventory) != 18 or any(
                r.get("properties", {}).get("incident_id") != incident_id or
                r.get("properties", {}).get("demo_record") != "yes" for r in inventory):
            raise RuntimeError("Remote inventory must be exactly 18 current synthetic cases")
        contacts = _request(client, "GET", "/contacts/", params={"locationId": location, "limit": 100},
                            headers={"Version": "2021-07-28"}).get("contacts", [])
        mapped_contacts = [c for c in contacts if c.get("id") in mapped_ids]
        if len(mapped_contacts) != 30 or any(not str(c.get("email", "")).endswith("@example.test") or c.get("phone") for c in mapped_contacts):
            raise RuntimeError("Expected 30 mapped synthetic contacts without phone numbers")
        control_search = _request(client, "POST", f"/objects/{OBJECT}/records/search", json={
            "locationId": location, "page": 1, "pageLimit": 20,
            "query": control_key, "searchAfter": []})
        if any(item.get("properties", {}).get("case_key") == control_key
               for item in control_search.get("records", [])):
            raise RuntimeError("Green Dental unexpectedly has a checkout Service Case in GHL")
        statuses = {}
        for row in rows:
            case = _request(client, "GET", f"/objects/{OBJECT}/records/{row['ghl_record_id']}",
                            params={"locationId": location})
            record = case.get("record", case)
            props = record.get("properties", {})
            technical = props.get("technical_status")
            if technical != "RECOVERED":
                raise RuntimeError("Current Service Case technical status is not RECOVERED")
            customer = props.get("customer_status")
            case_key = f"SC-{row['incident_id']}-{row['customer_key']}"
            if props.get("case_key") != case_key or props.get("demo_record") != "yes":
                raise RuntimeError("GHL case identity or demo marker mismatch")
            statuses[customer] = statuses.get(customer, 0) + 1
            if row["customer_key"] in ("acme-bikes", "ocean-apparel-02"):
                relations = _request(client, "GET", f"/associations/relations/{row['contact_id']}",
                                     params={"locationId": location, "skip": 0, "limit": 100}).get("relations", [])
                if not any(item.get("secondRecordId") == row["ghl_record_id"] and
                           item.get("associationId") == ASSOCIATION_ID for item in relations):
                    raise RuntimeError("Missing visible Contact ↔ Service Case association")
                tasks = _request(client, "GET", f"/contacts/{row['contact_id']}/tasks").get("tasks", [])
                matching_tasks = [task for task in tasks if task.get("title") ==
                                  f"RelayCart follow-up · {incident_id}"]
                expected = 1 if row["customer_key"] == "ocean-apparel-02" else 0
                if len(matching_tasks) != expected:
                    raise RuntimeError(f"Unexpected support task count for {row['customer_key']}")
                print(row["customer_key"], "technical=" + str(technical), "customer=" + str(customer),
                      "case=" + row["ghl_record_id"], "tasks=" + str(len(matching_tasks)))
            time.sleep(0.4)
        print("cases", len(rows), "green_dental_cases", control, "status_counts", statuses)
        if statuses != {"CONFIRMED_RESOLVED": 1, "AWAITING_CONFIRMATION": 16, "NEEDS_FOLLOW_UP": 1}:
            raise RuntimeError("Final customer status split differs from 16/1/1")
        # Contact-scoped reads cannot find tasks orphaned by deleted test contacts.
        # Exhaust the entire location inventory without a contact/status filter.
        location_tasks = []
        skip = 0
        while True:
            batch = _request(client, "POST", f"/locations/{location}/tasks/search",
                             json={"limit": 100, "skip": skip}).get("tasks", [])
            location_tasks.extend(batch)
            if len(batch) < 100:
                break
            skip += len(batch)
        relaycart_tasks = [task for task in location_tasks
                          if str(task.get("title", "")).startswith("RelayCart follow-up · INC-")
                          and task.get("deleted") is not True]
        ocean_contact = next(row["contact_id"] for row in rows
                             if row["customer_key"] == "ocean-apparel-02")
        if (len(relaycart_tasks) != 1 or
                relaycart_tasks[0].get("title") != f"RelayCart follow-up · {incident_id}" or
                relaycart_tasks[0].get("contactId") != ocean_contact):
            raise RuntimeError("Location-wide RelayCart task inventory must contain only current Ocean task")
        print("location_wide_relaycart_tasks=1 current_ocean_tasks=1 older_relaycart_tasks=0")
        print("remote_inventory=18 mapped_synthetic_contacts=30 mapped_phones=0 unmapped_contacts=" +
              str(len(contacts)-len(mapped_contacts)) + " audit=PASS")


if __name__ == "__main__":
    main()
